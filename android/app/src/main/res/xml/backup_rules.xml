<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older: the secure storage is encrypted with a Keystore key
     that never leaves the phone, so a restored copy could not be read -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
    <exclude domain="sharedpref" path="FlutterSecureKeyStorage.xml" />
</full-backup-content>
